# ─────────────────────────────────────────────────────────────────────────────
# AI Emergency Command System — Server Environment Reference
# Copy this file to .env and fill in your values before starting the server.
# DO NOT commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ────────────────────────────────────────────────────────────────────
NODE_ENV=production          # development | production | test
PORT=5000                    # HTTP server port

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/emergency_db?retryWrites=true&w=majority

# ── JSON Web Token ───────────────────────────────────────────────────────────
# Use a cryptographically random 256-bit secret in production.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_very_long_random_secret_string
JWT_EXPIRES_IN=7d            # Token lifetime (e.g. 7d, 24h, 30d)

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. In development use http://localhost:5173.
ALLOWED_ORIGINS=https://your-production-domain.com,https://www.your-production-domain.com

# ── Redis (for horizontal scaling & Socket.io adapter) ───────────────────────
# If not set, the app falls back to in-memory mode (single-instance only).
REDIS_URL=redis://:<password>@<host>:6379
# REDIS_TLS=true             # Uncomment if Redis requires TLS (e.g. Redis Cloud)

# ── Exotel (IVR / automated calling) ────────────────────────────────────────
EXOTEL_SID=your_exotel_sid
EXOTEL_TOKEN=your_exotel_api_token
EXOTEL_FROM=your_exotel_virtual_number   # e.g. 08XXXXXXXX
EXOTEL_SUBDOMAIN=api.exotel.com          # or your Exotel regional subdomain

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info               # error | warn | info | http | debug

# ── Rate Limiting (optional overrides) ───────────────────────────────────────
# AUTH_RATE_LIMIT_MAX=30
# EMERGENCY_RATE_LIMIT_MAX=60
# ACTION_RATE_LIMIT_MAX=120

# ── Health Check ─────────────────────────────────────────────────────────────
# Kubernetes / ECS liveness probe: GET /health
# Readiness probe:                 GET /health/ready
